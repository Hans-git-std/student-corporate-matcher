# ===================================================================
# Student-Corporate Matcher Environment Configuration Template
# Copy this file to .env and fill in your actual production values
# ===================================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL / TiDB Cloud Wire Compatible)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_matcher_db
DB_USERNAME=root
DB_PASSWORD=your_database_password

# Security JWT Secret & Expiration (28 Days)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2419200000

# Master Admin Credentials & Emergency Recovery
ADMIN_EMAIL=admin@studentmatcher.com
ADMIN_RECOVERY_EMAIL=hans31144@gmail.com
ADMIN_PASSWORD=SetAStrongMasterPasswordHere123!

# Free Gmail SMTP Quota & Anti-Abuse Protection
MAIL_DAILY_LIMIT=400
MAIL_RESEND_COOLDOWN=60
MAIL_HOURLY_LIMIT_PER_EMAIL=3

# Dedicated SMTP Configuration (e.g., Gmail SMTP or SendGrid / AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Student Corporate Matcher Platform
